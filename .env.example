# Copy this file to .env at the repo root and fill in your values.
# Never commit .env -- only .env.example is safe to commit.

# ── PostgreSQL (source of truth) ────────────────────────────────────────────────
# Read by a4_load_and_embed, d3_load_tiers, db_persist_*, e2_embed_incoming,
# holdout.promote(), and the FastAPI service.
PGHOST=localhost
PGPORT=5432
PGDATABASE=longitudinal_bhc_test
PGUSER=postgres
PGPASSWORD=your-password-here

# Databases no stage may write to (comma-separated). database/pg.py refuses them -- for
# every stage, the API and src/ingest -- unless LONGSUM_ALLOW_PROTECTED_DB=1 is set for
# that run. Guards against a shell that forgot PGDATABASE falling through to this file.
# Default if unset: longitudinal_bhc
# LONGSUM_PROTECTED_DBS=longitudinal_bhc,longitudinal_bhc_test
# LONGSUM_ALLOW_PROTECTED_DB=1

# ── Credentialed BHC source CSV (patient-derived; NEVER committed) ───────────────
# Field `target` holds the BHC text, one row per admission. Read by a1/a2 via
# config.SOURCE_CSV. Defaults to data/input/bhc_source.csv under the repo if unset.
LONGSUM_SOURCE_CSV=C:/path/to/your/bhc_source.csv

# ── Ollama (optional) ───────────────────────────────────────────────────────────
# Non-default endpoint for local inference. Leave unset to use Ollama's default.
# OLLAMA_HOST=http://127.0.0.1:11434

# ── Run namespace (optional; generalization / parallel cohort) ──────────────────
# UNSET = default (all file artifacts under data/). Set (e.g. gen) => data_gen/.
# The Postgres DB is NOT namespaced: never set this for a DB-writing stage
# (a4 / db_persist_* / d3 / e2 / the API). File-only stages only.
# LONGSUM_NAMESPACE=

# ── Embedding model (informational; the code pins this name directly) ───────────
EMBED_MODEL=Snowflake/snowflake-arctic-embed-l-v2.0
